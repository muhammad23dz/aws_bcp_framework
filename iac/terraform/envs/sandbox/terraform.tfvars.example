# AWS BCP Framework - Sandbox Environment Configuration
# Copy this file to terraform.tfvars and update with your values

# Required Variables
account_id              = "<SANDBOX_ACCOUNT_ID>"
ami_id                  = "<AMI_ID_FOR_DR_REGION>"
terraform_state_bucket  = "<TERRAFORM_STATE_BUCKET_NAME>"
terraform_lock_table   = "<TERRAFORM_LOCK_TABLE_NAME>"

# Optional Variables (defaults shown)
project_name            = "aws-bcp-framework"
environment             = "sandbox"
primary_region          = "us-east-1"
dr_region               = "us-west-2"
primary_vpc_cidr        = "10.0.0.0/16"
dr_vpc_cidr             = "10.1.0.0/16"
dr_subnet_cidr          = "10.1.1.0/24"
warm_standby_vpc_cidr   = "10.2.0.0/16"
warm_standby_subnet_cidr = "10.2.1.0/24"
instance_type           = "t3.micro"
allowed_cidr            = "10.0.0.0/16"
source_server_id         = ""
